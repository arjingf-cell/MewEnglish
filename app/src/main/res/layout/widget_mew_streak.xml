<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_klasik"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <!-- Top Info Row: Cat on Left, Status + Shield on Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Cat Container with Flag -->
        <FrameLayout
            android:id="@+id/widget_cat_container"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/widget_cat_box_klasik">

            <ImageView
                android:id="@+id/widget_cat_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Cat with Flag"
                android:scaleType="centerInside" />
        </FrameLayout>

        <!-- Status Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title & Shield Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Bugünkü serin güvende!"
                    android:textColor="#17324A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Shield Badge -->
                <LinearLayout
                    android:id="@+id/widget_shield_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_shield_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Streak Shield"
                        android:src="@drawable/ic_widget_shield_active" />

                    <TextView
                        android:id="@+id/widget_shield_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="Kalkan Aktif"
                        android:textColor="#0284C7"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Subtitle / Warning / Streak Description -->
            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="5 Günlük Seri Devam Ediyor"
                android:textColor="#6C8297"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider Spacer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="6dp" />

    <!-- 7-Day Flame Row (Mon -> Sun) -->
    <LinearLayout
        android:id="@+id/widget_flame_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Day 0 (Pzt) -->
        <LinearLayout
            android:id="@+id/widget_day_col_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/widget_day_text_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pzt"
                android:textColor="#64748B"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day_flame_0"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Pzt Flame"
                android:src="@drawable/ic_widget_flame_active" />
        </LinearLayout>

        <!-- Day 1 (Sal) -->
        <LinearLayout
            android:id="@+id/widget_day_col_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/widget_day_text_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sal"
                android:textColor="#64748B"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day_flame_1"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Sal Flame"
                android:src="@drawable/ic_widget_flame_active" />
        </LinearLayout>

        <!-- Day 2 (Çar) -->
        <LinearLayout
            android:id="@+id/widget_day_col_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/widget_day_text_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Çar"
                android:textColor="#64748B"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day_flame_2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Çar Flame"
                android:src="@drawable/ic_widget_flame_active" />
        </LinearLayout>

        <!-- Day 3 (Per) -->
        <LinearLayout
            android:id="@+id/widget_day_col_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/widget_day_text_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Per"
                android:textColor="#64748B"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day_flame_3"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Per Flame"
                android:src="@drawable/ic_widget_flame_active" />
        </LinearLayout>

        <!-- Day 4 (Cum) -->
        <LinearLayout
            android:id="@+id/widget_day_col_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/widget_day_text_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cum"
                android:textColor="#64748B"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day_flame_4"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Cum Flame"
                android:src="@drawable/ic_widget_flame_active" />
        </LinearLayout>

        <!-- Day 5 (Cmt) -->
        <LinearLayout
            android:id="@+id/widget_day_col_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/widget_day_text_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cmt"
                android:textColor="#64748B"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day_flame_5"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Cmt Flame"
                android:src="@drawable/ic_widget_flame_inactive" />
        </LinearLayout>

        <!-- Day 6 (Paz) -->
        <LinearLayout
            android:id="@+id/widget_day_col_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/widget_day_text_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paz"
                android:textColor="#64748B"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day_flame_6"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:contentDescription="Paz Flame"
                android:src="@drawable/ic_widget_flame_inactive" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
