        // 7. Soru: createListening (How much money - Para dinlemesi)
        createListening(
            id = 7,
            qTurkish = "How much money do you have in your wallet?",
            res = R.drawable.pp2,
            ansEnglish = "Cüzdanında ne kadar para var?",
            opts = listOf(
                "Cüzdanında ne kadar para var?",
                "Cüzdanında kaç tane kart var?",
                "Paranı nerede harcadın?",
                "Cüzdanını nerede unuttun?"
            )
