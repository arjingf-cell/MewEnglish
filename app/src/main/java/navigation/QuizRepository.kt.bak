        3, // 👈 4 yeni hedef kelime ilk kez öğreniliyor

        // 1. VISUAL (paint)
        createVisual(
            id = 1,
            questionTurkish = "resim yapmak / boyamak",
            imageRes = R.drawable.paint,
            correctAnswer = "paint",
            options = listOf("paint", "read", "cook", "write")
        ),

        // 2. LISTENING (Giriş / Karakter pp1)
        createListening(
            id = 2,
            qTurkish = "I like to paint colorful pictures.",
            res = R.drawable.pp1,
            ansEnglish = "Renkli resimler yapmayı severim.",
            opts = listOf(
                "Renkli resimler yapmayı severim.",
                "Renkli resimler satın alırım.",
                "Resimleri duvara asmayı severim.",
                "Resim sergilerini gezmeyi severim."
            )
        ),

        // 3. VISUAL (read)
        createVisual(
            id = 3,
            questionTurkish = "okumak",
            imageRes = R.drawable.read,
            correctAnswer = "read",
            options = listOf("read", "write", "cook", "paint")
        ),

        // 4. LISTENING (Present Simple / reads)
        createListening(
            id = 4,
            qTurkish = "She reads a book every night.",
            res = R.drawable.read,
            ansEnglish = "O her gece bir kitap okur.",
            opts = listOf(
                "O her gece bir kitap okur.",
                "O her gece bir kitap yazar.",
                "O her sabah gazete okur.",
                "O kütüphanede ders çalışır."
            )
        ),

        // 5. TRANSLATION_BUILDER (Cümle İnşası)
        VocabularyLevelDataQuiz(
            id = 5,
            questionTurkish = "Boş zamanlarımda kitap okurum.",
            imageRes = R.drawable.read,
            correctAnswer = "I read books in my free time",
            questionType = QuestionType.TRANSLATION_BUILDER,
            options = emptyList(),
            correctWords = listOf("I", "read", "books", "in", "my", "free", "time"),
            extraWords = listOf("reads", "cooks", "to"),
            fullAnswerTurkish = "Boş zamanlarımda kitap okurum."
        ),

        // 6. VISUAL (cook)
        createVisual(
            id = 6,
            questionTurkish = "yemek pişirmek",
            imageRes = R.drawable.cook,
            correctAnswer = "cook",
            options = listOf("cook", "paint", "read", "write")
        ),

        // 7. SPEAKING (Telaffuz / can + yalın fiil)
        VocabularyLevelDataQuiz(
            id = 7,
            questionTurkish = "He can cook delicious meals.",
            imageRes = R.drawable.cook,
            correctAnswer = "He can cook delicious meals",
            options = emptyList(),
            questionType = QuestionType.SPEAKING,
            speakingTitle = "Aşağıdaki cümleyi sesli telaffuz et:",
            speakingSentence = "He can cook delicious meals",
            speakingCharacterRes = R.drawable.pp2
        ),

        // 8. LISTENING (Birlikte aktivite)
        createListening(
            id = 8,
            qTurkish = "We cook dinner together on Sundays.",
            res = R.drawable.cook,
            ansEnglish = "Pazar günleri birlikte akşam yemeği pişiririz.",
            opts = listOf(
                "Pazar günleri birlikte akşam yemeği pişiririz.",
                "Pazar günleri dışarıda akşam yemeği yeriz.",
                "Cumartesi günleri kahvaltı hazırlarız.",
                "Pazar günleri birlikte tatlı yaparız."
            )
        ),

        // 9. VISUAL (write)
        createVisual(
            id = 9,
            questionTurkish = "yazmak",
            imageRes = R.drawable.write,
            correctAnswer = "write",
            options = listOf("write", "cook", "paint", "read")
        ),

        // 10. LISTENING (Bağlamsal günlük kullanımı)
        createListening(
            id = 10,
            qTurkish = "She writes stories in her diary.",
            res = R.drawable.write,
            ansEnglish = "O, günlüğüne hikayeler yazar.",
            opts = listOf(
                "O, günlüğüne hikayeler yazar.",
                "O, günlüğüne notlar yapıştırır.",
                "O, günlüğünü arkadaşına okur.",
                "O, defterine şiirler yazar."
            )
        ),

        // 11. TRANSLATION_BUILDER (Modal / can + paint)
        VocabularyLevelDataQuiz(
            id = 11,
            questionTurkish = "Güzel resimler boyayabilirsin.",
            imageRes = R.drawable.paint,
            correctAnswer = "You can paint beautiful pictures",
            questionType = QuestionType.TRANSLATION_BUILDER,
            options = emptyList(),
            correctWords = listOf("You", "can", "paint", "beautiful", "pictures"),
            extraWords = listOf("paints", "write", "at"),
            fullAnswerTurkish = "Güzel resimler boyayabilirsin."
        ),

        // 12. LISTENING (Doğa teması)
        createListening(
            id = 12,
            qTurkish = "My sister loves to paint nature.",
            res = R.drawable.paint,
            ansEnglish = "Kız kardeşim doğayı resmetmeyi çok sever.",
            opts = listOf(
                "Kız kardeşim doğayı resmetmeyi çok sever.",
                "Kız kardeşim doğada yürümeyi çok sever.",
                "Kız kardeşim doğa fotoğrafları çeker.",
                "Kız kardeşim hayvanları korumayı sever."
            )
        ),

        // 13. SPEAKING (Mektup yazma telaffuzu)
        VocabularyLevelDataQuiz(
            id = 13,
            questionTurkish = "I write a letter to my friend.",
            imageRes = R.drawable.write,
            correctAnswer = "I write a letter to my friend",
            options = emptyList(),
            questionType = QuestionType.SPEAKING,
            speakingTitle = "Aşağıdaki cümleyi sesli telaffuz et:",
            speakingSentence = "I write a letter to my friend",
            speakingCharacterRes = R.drawable.pp3
        ),

        // 14. LISTENING (Soru formu)
        createListening(
            id = 14,
            qTurkish = "Do you cook for your family?",
            res = R.drawable.pp4,
            ansEnglish = "Ailen için yemek pişirir misin?",
            opts = listOf(
                "Ailen için yemek pişirir misin?",
                "Ailenle birlikte yemek yer misin?",
                "Ailen için alışveriş yapar mısın?",
                "Ailene kahvaltı hazırlar mısın?"
            )
        ),

        // 15. MATCHING (Özet Eşleştirme)
        createMatching(
            id = 15,
            questionText = "Hobbies Review 1",
            image = R.drawable.pp1,
            pairs = "paint,read,cook,write",
            turkishOptions = listOf("boyamak", "okumak", "yemek pişirmek", "yazmak")
        )
    )
}

// ==========================================
// QUIZ 290: Beceriler, Tercihler ve İpuçları
// ==========================================
fun getQuiz290(): List<VocabularyLevelDataQuiz> {
    return quizListOf(
        7, // 👈 Pekiştirme seti (Kelimeler 289'da öğrenildi)

        // 1. VISUAL (cook)
        createVisual(
            id = 1,
            questionTurkish = "yemek pişirmek",
            imageRes = R.drawable.cook,
            correctAnswer = "cook",
            options = listOf("cook", "write", "paint", "read")
        ),

        // 2. LISTENING (Soru / can cook)
        createListening(
            id = 2,
            qTurkish = "Can you cook Italian pasta?",
            res = R.drawable.pp2,
            ansEnglish = "İtalyan makarnası pişirebilir misin?",
            opts = listOf(
                "İtalyan makarnası pişirebilir misin?",
                "İtalyan makarnası yemeyi sever misin?",
                "İtalyan restoranına gider misin?",
                "İtalyan tatlısı yapabilir misin?"
            )
        ),

        // 3. VISUAL (write)
        createVisual(
            id = 3,
            questionTurkish = "yazmak",
            imageRes = R.drawable.write,
            correctAnswer = "write",
            options = listOf("write", "paint", "read", "cook")
        ),

        // 4. TRANSLATION_BUILDER (Zarf kullanımı / quickly)
        VocabularyLevelDataQuiz(
            id = 4,
            questionTurkish = "O çok hızlı yazabilir.",
            imageRes = R.drawable.write,
            correctAnswer = "He can write very quickly",
            questionType = QuestionType.TRANSLATION_BUILDER,
