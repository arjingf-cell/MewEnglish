        // 6. VISUAL (paint)
        createVisual(
            id = 6,
            questionTurkish = "resim yapmak / boyamak",
            imageRes = R.drawable.paint,
            correctAnswer = "paint",
            options = listOf("paint", "cook", "read", "write")
