    fun getQuizOne(): List<VocabularyLevelDataQuiz> {
        return quizListOf(
        9,
            // 1. GÖRSEL: İlk Tanışma (hello - Merhaba)
            createVisual(
                id = 1,
                questionTurkish = "mutlu",
                imageRes = R.drawable.kedi1,
                correctAnswer = "happy",
                options = listOf("happy", "angry", "sad", "bored")
            ),

            // 2. DİNLEME: İlk Selamlama Cümlesi (Hello! How are you?)
            createListening(
                id = 2,
                qTurkish = "Hello! How are you?",
                res = R.drawable.pp4,
                ansEnglish = "Merhaba! Nasılsın?",
                opts = listOf("Merhaba! Nasılsın?", "Hoşça kal! Neredesin?", "Günaydın! Kimsin?")
            ),

            // 3. GÖRSEL: Duygu / Durum (happy - Mutlu)
            createVisual(
                id = 3,
                questionTurkish = "Hangisi 'mutlu' anlamına gelir?",
                imageRes = R.drawable.happy,
                correctAnswer = "happy",
                options = listOf("happy", "angry", "tired", "sad")
            ),

            // 4. DİNLEME: Durum Yanıtı (I am fine, thank you.)
            createListening(
                id = 4,
                qTurkish = "I am fine, thank you.",
                res = R.drawable.pp5,
                ansEnglish = "İyiyim, teşekkür ederim.",
                opts = listOf("İyiyim, teşekkür ederim.", "Yorgunum, teşekkürler.", "Kötüyüm, sağ ol.")
            ),
            // 5. TRANSLATION_BUILDER (Eski ve yeni kelimeler bir arada mantıklı cümle)
            VocabularyLevelDataQuiz(
                id = 5,
                questionTurkish = "Ben iyiyim.",
                imageRes = R.drawable.pp2,
                correctAnswer = "I am fine",
                questionType = QuestionType.TRANSLATION_BUILDER,
                options = emptyList(),
                correctWords = listOf("am", "I", "fine"),
                extraWords = listOf("bad", "are", "you"),
                fullAnswerTurkish = "Ben iyiyim."
            ),
        

            

            // 6. GÖRSEL: Maskotumuz (cat - Kedi)
            createVisual(
                id = 6,
                questionTurkish = "kedi",
                imageRes = R.drawable.cat,
                correctAnswer = "cat",
                options = listOf("cat", "dog", "bird", "fish")
            ),

            // 7. DİNLEME: Veda Kalıbı (Goodbye! See you soon.)
            createListening(
                id = 7,
                qTurkish = "Goodbye! See you soon.",
                res = R.drawable.kedi4,
                ansEnglish = "Hoşça kal! Yakında görüşürüz.",
                opts = listOf("Hoşça kal! Yakında görüşürüz.", "Merhaba! Günaydın.", "Özür dilerim! Teşekkürler.")
            ),

            // 8. FİNAL EŞLEŞTİRME: İlk Başarı ve Özet
            createMatching(
                id = 8,
                questionText = "İlk İngilizce kelimelerini eşleştir!",
                image = R.drawable.cat_logo,
                pairs = "hello,happy,cat,goodbye",
                turkishOptions = listOf("Merhaba", "Mutlu", "Kedi", "Hoşça kal")
            )
        )
    }
    fun getQuizTwo(): List<VocabularyLevelDataQuiz> {
        return quizListOf(
        20,
            createListening(
                id = 1,
                qTurkish = "Nice to meet you!",
                res = R.drawable.pp2,
                ansEnglish = "Tanıştığımıza memnun oldum!",
                opts = listOf("Tanıştığımıza memnun oldum!", "Nasılsın?", "Görüşürüz")
            ),
            // 6. GÖRSEL: Maskotumuz (cat - Kedi)
            createVisual(
                id = 2,
                questionTurkish = "kuş",
                imageRes = R.drawable.bird,
                correctAnswer = "bird",
                options = listOf("cat", "dog", "bird", "fish")
            ),
            createListening(
                id = 3,
                qTurkish = "I am from Turkey.",
                res = R.drawable.kisi4,
                ansEnglish = "Türkiyeli'yim.",
                opts = listOf("Almanya'danım", "Türkiyeli'yim.", "Burada yaşıyorum")
            ),
            // 6. GÖRSEL: Maskotumuz (cat - Kedi)
            createVisual(
                id = 6,
                questionTurkish = "köpek",
                imageRes = R.drawable.dog,
                correctAnswer = "dog",
                options = listOf("cat", "dog", "bird", "fish")
            ),
            createListening(
                id = 5,
                qTurkish = "Have a nice day!",
                res = R.drawable.kisi1,
                ansEnglish = "İyi günler!",
                opts = listOf("İyi günler!", "Hoşça kal!", "Merhaba")
            ),
            // 6. GÖRSEL: Maskotumuz (cat - Kedi)
            createVisual(
                id = 6,
                questionTurkish = "sinirli",
                imageRes = R.drawable.angry,
                correctAnswer = "angry",
                options = listOf("angry", "happy", "sad", "bored")
            ),
            createListening(
                id = 7,
                qTurkish = "Are you a student?",
                res = R.drawable.pp6,
                ansEnglish = "Öğrenci misin?",
                opts = listOf("Öğrenci misin?", "Öğretmen misin?", "Doktor musun?")
            ),
            createListening(
                id = 8,
                qTurkish = "Yes, I am.",
                res = R.drawable.kisi4,
                ansEnglish = "Evet, öyleyim.",
                opts = listOf("Hayır, değilim.", "Evet, öyleyim.", "Belki")
            ),
            createListening(
                id = 9,
                qTurkish = "And you?",
                res = R.drawable.kisi1,
                ansEnglish = "Ya sen?",
                opts = listOf("Neden?", "Nasıl?", "Ya sen?")
            ),
            // Eşleştirme sorusu ile kapanış
            createMatching(
                id = 10,
                questionText = "Kalıpları doğru karşılıklarıyla eşleştir",
                image = R.drawable.cat_logo,
                pairs = "Nice to meet you,Where are you from,Good morning,See you,Student",
                turkishOptions = listOf("Memnun oldum", "Nerelisin", "Günaydın", "Görüşürüz", "Öğrenci")
            )
        )
    }

