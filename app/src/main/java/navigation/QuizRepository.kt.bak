        // 7. SPEAKING (want to paint)
        VocabularyLevelDataQuiz(
            id = 7,
            questionTurkish = "I want to paint the walls.",
            imageRes = R.drawable.paint,
            correctAnswer = "I want to paint the walls",
            options = emptyList(),
            questionType = QuestionType.SPEAKING,
            speakingTitle = "Aşağıdaki cümleyi sesli telaffuz et:",
            speakingSentence = "I want to paint the walls",
            speakingCharacterRes = R.drawable.pp4
        ),

        // 8. LISTENING (Sulu boya pratiği)
        createListening(
            id = 8,
            qTurkish = "Can she paint with watercolors?",
            res = R.drawable.paint,
            ansEnglish = "Sulu boya ile resim yapabilir mi?",
            opts = listOf(
                "Sulu boya ile resim yapabilir mi?",
                "Yağlı boya tablo yapabilir mi?",
                "Fırça kullanmayı biliyor mu?",
                "Duvar boyamayı sever mi?"
            )
        ),

        // 9. VISUAL (read)
        createVisual(
            id = 9,
            questionTurkish = "okumak",
            imageRes = R.drawable.read,
            correctAnswer = "read",
            options = listOf("read", "cook", "paint", "write")
        ),

        // 10. TRANSLATION_BUILDER (article / makale okuma)
        VocabularyLevelDataQuiz(
            id = 10,
            questionTurkish = "Her gün yeni bir makale okurum.",
            imageRes = R.drawable.read,
            correctAnswer = "I read a new article every day",
            questionType = QuestionType.TRANSLATION_BUILDER,
            options = emptyList(),
            correctWords = listOf("I", "read", "a", "new", "article", "every", "day"),
            extraWords = listOf("reads", "write", "book"),
            fullAnswerTurkish = "Her gün yeni bir makale okurum."
        ),

        // 11. LISTENING (Telefon ve haber okuma)
        createListening(
            id = 11,
            qTurkish = "Do you read news on your phone?",
            res = R.drawable.read,
            ansEnglish = "Telefonundan haber okur musun?",
            opts = listOf(
                "Telefonundan haber okur musun?",
                "Telefonundan video izler misin?",
                "Telefonundan mesaj yazar mısın?",
                "Telefonundan kitap dinler misin?"
            )
        ),

        // 12. SPEAKING (3. tekil şahıs -s kuralı telaffuzu)
        VocabularyLevelDataQuiz(
            id = 12,
            questionTurkish = "My father cooks very well.",
            imageRes = R.drawable.cook,
            correctAnswer = "My father cooks very well",
            options = emptyList(),
            questionType = QuestionType.SPEAKING,
            speakingTitle = "Aşağıdaki cümleyi sesli telaffuz et:",
            speakingSentence = "My father cooks very well",
            speakingCharacterRes = R.drawable.pp5
        ),

        // 13. LISTENING (Olumsuz yapı / does not cook)
        createListening(
            id = 13,
            qTurkish = "She does not cook spicy food.",
            res = R.drawable.cook,
            ansEnglish = "O baharatlı yemekler pişirmez.",
            opts = listOf(
                "O baharatlı yemekler pişirmez.",
                "O baharatlı yemekler sevmez.",
                "O tuzlu yemekler pişirmez.",
                "O tatlı yemekler yapmaz."
            )
        ),

        // 14. LISTENING (Şiir yazma bağlamı)
        createListening(
            id = 14,
            qTurkish = "They write poems about nature.",
            res = R.drawable.write,
            ansEnglish = "Onlar doğa hakkında şiirler yazarlar.",
            opts = listOf(
                "Onlar doğa hakkında şiirler yazarlar.",
                "Onlar doğa hakkında şarkılar söylerler.",
                "Onlar doğa hakkında kitaplar okurlar.",
                "Onlar doğa hakkında resimler çizerler."
            )
        ),

        // 15. MATCHING (Özet Eşleştirme 2)
        createMatching(
            id = 15,
            questionText = "Hobbies Review 2",
            image = R.drawable.pp2,
            pairs = "cook,write,paint,read",
            turkishOptions = listOf("yemek pişirmek", "yazmak", "boyamak", "okumak")
        )
    )
}

