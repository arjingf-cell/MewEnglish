            extraWords = listOf("writes", "read", "slow"),
            fullAnswerTurkish = "O çok hızlı yazabilir."
        ),

        // 5. LISTENING (Rica / Emir cümlesi)
        createListening(
            id = 5,
            qTurkish = "Please write your name here.",
            res = R.drawable.write,
            ansEnglish = "Lütfen adınızı buraya yazın.",
            opts = listOf(
                "Lütfen adınızı buraya yazın.",
                "Lütfen adresinizi buraya yazın.",
                "Lütfen imzanızı buraya atın.",
                "Lütfen adınızı sesli söyleyin."
