@Composable
fun QuizTreeScreen(navController: NavController, levelName: String = "A1") {
    val context = LocalContext.current
    val progress = remember { QuizTreeProgressStore.loadAll(context) }
    val lastSolvedIndex = remember(progress) { QuizTreeProgressStore.lastSolvedIndex(progress) }
    val coins = remember(progress) { QuizTreeProgressStore.getCoins(context) }
    val gems = remember(progress) { QuizTreeProgressStore.getGems(context) }

    val isA2 = levelName.equals("A2", ignoreCase = true)
    val allSteps = remember(isA2) {
        if (isA2) QuizDataHolder.quizStepsA2 else QuizDataHolder.quizSteps
    }
    val mapItems = remember(allSteps, isA2) { buildMapItems(allSteps, isA2 = isA2) }
    val scrollState = rememberLazyListState()
    val solvedCount = remember(progress, allSteps) {
        allSteps.count { step ->
            val result = progress[step.id - 1]
            val stars = QuizTreeProgressStore.starsFor(result)
            stars >= 1
        }
    }
    var skipQuizIndex by remember { mutableStateOf<Int?>(null) }
    val screenWidth = LocalConfiguration.current.screenWidthDp.dp
    val coroutineScope = rememberCoroutineScope()
    val appColors = LocalAppThemeColors.current
    val isDark = LocalIsDarkMode.current
    var showBalloonDialog by remember { mutableStateOf(false) }

    Scaffold(
        containerColor = appColors.background,
        topBar = {
            // ✅ YAMA: Animasyonlu ve ayrık TopBar kullanımı
            QuizTreeTopBar(
                navController = navController,
                levelName = levelName,
                coins = coins,
                gems = gems
            )
        }
    ) { paddingValues ->
        Box(modifier = Modifier.padding(paddingValues).fillMaxSize().mewScreenBackground()) {

            LazyColumn(
                state = scrollState,
                modifier = Modifier.fillMaxSize(),
                contentPadding = PaddingValues(top = 16.dp, bottom = 100.dp),
                horizontalAlignment = Alignment.CenterHorizontally
            ) {
                // ✅ YAMA: %60 muhabbeti ve Professor Cat olan banner
                item {
                    QuizTreeBanner(screenWidth)
                }

                // Gösterge (Toplam quiz sayısı ve çözülmüş olanlar)
                item {
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(horizontal = 24.dp, vertical = 8.dp),
                        horizontalArrangement = Arrangement.SpaceBetween,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(
                            text = "Tamamlanan Konular",
                            style = TextStyle(
                                fontSize = 14.sp,
                                fontWeight = FontWeight.Bold,
                                color = appColors.textMuted
                            )
                        )
                        Surface(
                            shape = RoundedCornerShape(12.dp),
                            color = appColors.surfaceRaised,
                            border = BorderStroke(1.dp, appColors.border)
                        ) {
                            Text(
                                text = "$solvedCount / ${allSteps.size}",
                                style = TextStyle(
                                    fontSize = 14.sp,
                                    fontWeight = FontWeight.ExtraBold,
                                    color = appColors.text
                                ),
                                modifier = Modifier.padding(horizontal = 12.dp, vertical = 6.dp)
                            )
                        }
                    }
                }

                itemsIndexed(
                    items = mapItems,
                    key = { _, item ->
                        when(item) {
                            is MapItem.QuizNode -> "q_${item.quizIndex}"
                            is MapItem.UnitHeader -> "u_${item.unitNumber}"
                            is MapItem.SectionHeader -> "s_${item.sectionNumber}"
                        }
                    }
                ) { index, mapItem ->
                    when (mapItem) {
                        is MapItem.QuizNode -> {
                            val stepIndexInLevel = allSteps.indexOfFirst { it.id == mapItem.step.id }
                            val quizIndex = mapItem.step.id - 1
                            val starCount = QuizTreeProgressStore.starsFor(progress[quizIndex])
                            val isSolved = starCount >= 1
                            val isLocked = if (stepIndexInLevel <= 0) false else QuizTreeProgressStore.starsFor(progress[allSteps[stepIndexInLevel - 1].id - 1]) < 1

                            // ✅ HİZALAMA: Görseldeki gibi zigzag akışı
                            val alignment = when {
                                stepIndexInLevel == 0 -> Alignment.Center
                                stepIndexInLevel % 2 == 1 -> Alignment.CenterStart
                                else -> Alignment.CenterEnd
                            }

                            Box(
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .padding(horizontal = 24.dp, vertical = 8.dp)
                                    .height(90.dp),
                                contentAlignment = alignment
                            ) {
                                val blueStarCount = QuizTreeProgressStore.getReinforcementStars(context, quizIndex)
                                DuoQuizNode(
                                    step = mapItem.step,
                                    isSolved = isSolved,
                                    isLocked = isLocked,
                                    starCount = starCount,
                                    blueStarCount = blueStarCount,
                                    sectionIndex = mapItem.sectionIndex,
                                    currentIndex = index,
                                    totalQuestions = mapItems.size,
                                    nodeColor = Color.White,
                                    onClick = {
                                        if (!isLocked) {
                                            navController.navigate("test_${mapItem.step.id}")
                                        } else {
                                            skipQuizIndex = quizIndex
                                        }
                                    }
                                )
                            }
                        }
                        is MapItem.UnitHeader -> UnitHeaderCard(mapItem.unitNumber, mapItem.title)
                        is MapItem.SectionHeader -> MasteryCard()
                    }
                }
            }

            skipQuizIndex?.let { targetIndex ->
                SkipQuizDialog(
                    onConfirm = {
                        val prefs = context.getSharedPreferences("quiz_tree_progress", Context.MODE_PRIVATE)
                        val editor = prefs.edit()
                        for (i in (lastSolvedIndex + 1) until targetIndex) {
                            editor.putString("quiz_attempt_$i", "0/0/0")
                        }
                        editor.apply()
                        skipQuizIndex = null
                        navController.navigate("test_${targetIndex + 1}")
                    },
                    onDismiss = {
                        skipQuizIndex = null
                    }
                )
            }

            // 🎈 Sağ Kenardaki Yüzen Balon ve Konuşma Balonu
            Row(
                modifier = Modifier
                    .align(Alignment.CenterEnd)
                    .padding(end = 16.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {
                if (showBalloonDialog) {
                    Surface(
                        modifier = Modifier
                            .width(200.dp)
                            .shadow(elevation = 6.dp, shape = RoundedCornerShape(16.dp)),
                        shape = RoundedCornerShape(16.dp),
                        color = appColors.surface,
                        border = BorderStroke(1.dp, appColors.border)
                    ) {
                        Column(
                            modifier = Modifier.padding(12.dp),
                            horizontalAlignment = Alignment.CenterHorizontally
                        ) {
                            Text(
                                text = "Kaldığın quizden devam etmek ister misin?",
                                fontSize = 12.sp,
                                fontWeight = FontWeight.Bold,
                                color = appColors.text,
                                textAlign = TextAlign.Center
                            )
                            Spacer(modifier = Modifier.height(10.dp))
                            Row(
                                modifier = Modifier.fillMaxWidth(),
                                horizontalArrangement = Arrangement.SpaceEvenly
                            ) {
                                Button(
                                    onClick = {
                                        showBalloonDialog = false
                                        val targetQuizIndex = Math.min(lastSolvedIndex + 1, allSteps.lastIndex)
                                        val targetMapItemIndex = mapItems.indexOfFirst {
                                            it is MapItem.QuizNode && it.quizIndex == targetQuizIndex
                                        }
                                        if (targetMapItemIndex >= 0) {
                                            coroutineScope.launch {
                                                scrollState.animateScrollToItem(targetMapItemIndex + 2)
                                            }
                                        }
                                    },
                                    colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF58CC02)),
                                    shape = RoundedCornerShape(8.dp),
                                    contentPadding = PaddingValues(horizontal = 12.dp, vertical = 4.dp),
                                    modifier = Modifier.height(28.dp)
                                ) {
                                    Text("Evet", color = Color.White, fontSize = 11.sp, fontWeight = FontWeight.Bold)
                                }
                                Button(
                                    onClick = {
                                        showBalloonDialog = false
                                    },
                                    colors = ButtonDefaults.buttonColors(containerColor = Color(0xFFEF5350)),
                                    shape = RoundedCornerShape(8.dp),
                                    contentPadding = PaddingValues(horizontal = 12.dp, vertical = 4.dp),
                                    modifier = Modifier.height(28.dp)
                                ) {
                                    Text("Hayır", color = Color.White, fontSize = 11.sp, fontWeight = FontWeight.Bold)
                                }
                            }
                        }
                    }
                    Spacer(modifier = Modifier.width(8.dp))
                }

                FloatingBalloonButton(
                    onClick = {
                        showBalloonDialog = !showBalloonDialog
                    }
                )
            }
        }
    }
}
// ✅ YENİ TOP BAR TASARIMI (Görseldeki gibi)
@Composable
fun QuizTreeTopBar(
    navController: NavController,
    levelName: String,
    coins: Int,
    gems: Int,
    currentIndex: Int = 0,
    totalQuestions: Int = 0,
    streakCount: Int = 0,
    hearts: Int = 5,
    isStreakActive: Boolean = false,
    onClose: () -> Unit = { navController.popBackStack() }
) {
    // ✅ Lottie kompozisyonlarını doğru şekilde yüklüyoruz
    val coinComposition by rememberLottieComposition(LottieCompositionSpec.RawRes(R.raw.anim_coin))
    val gemComposition by rememberLottieComposition(LottieCompositionSpec.RawRes(R.raw.anim_diamond))
    val xpComposition by rememberLottieComposition(LottieCompositionSpec.RawRes(R.raw.badge))

    val appColors = LocalAppThemeColors.current
    val isDark = LocalIsDarkMode.current

    Surface(
        modifier = Modifier.fillMaxWidth(),
        color = appColors.surface,
        shadowElevation = 2.dp,
        border = BorderStroke(1.dp, appColors.border)
    ) {
        Column(
            modifier = Modifier
                .padding(horizontal = 16.dp, vertical = 12.dp)
                .fillMaxWidth()
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                val context = LocalContext.current
                val xp = remember(coins, gems) { com.example.ngilizcequizapp.QuizTreeProgressStore.getXp(context) }

                // SOL: Altın (No plus)
                AnimatedResourceTag(
                    composition = coinComposition,
                    value = coins.toString(),
                    showPlus = false
                )

                // ORTA: XP (No plus, loop only once)
                AnimatedResourceTag(
                    composition = xpComposition,
                    value = "$xp XP",
                    showPlus = false,
                    iterations = 1
                )

                // SAĞ: Elmas (With plus at the end)
                AnimatedResourceTag(
                    composition = gemComposition,
                    value = gems.toString(),
                    showPlus = true
                )
            }

            Spacer(modifier = Modifier.height(12.dp))

            // Geri Tuşu ve Başlık Kısmı
            Row(
                modifier = Modifier.fillMaxWidth(),
                verticalAlignment = Alignment.CenterVertically
            ) {
                IconButton(onClick = onClose, modifier = Modifier.size(32.dp)) {
                    Icon(
                        imageVector = Icons.Default.ArrowBack,
                        contentDescription = "Back",
                        tint = appColors.text
                    )
                }

                Spacer(modifier = Modifier.width(12.dp))

                Column(modifier = Modifier.weight(1f)) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Text(
                            text = "$levelName Quiz Haritası",
                            style = TextStyle(
                                fontSize = 20.sp,
                                fontWeight = FontWeight.ExtraBold,
                                color = appColors.text
                            )
                        )
                        Spacer(modifier = Modifier.width(6.dp))
                        Icon(
                            imageVector = Icons.Default.Eco,
                            contentDescription = null,
                            tint = Color(0xFF81D4FA),
                            modifier = Modifier.size(18.dp)
                        )
                    }
                    Text(
                        text = "Learn step by step, grow every day!",
                        style = TextStyle(fontSize = 12.sp, color = appColors.textMuted)
                    )
                }
            }
        }
    }
}
@Composable
fun ProgressBannerCard(screenWidth: androidx.compose.ui.unit.Dp, navController: NavController) {
    Card(
        modifier = Modifier
            .fillMaxWidth()
            .padding(16.dp)
            .height(180.dp),
        shape = RoundedCornerShape(32.dp),
        colors = CardDefaults.cardColors(containerColor = Color.White),
        elevation = CardDefaults.cardElevation(defaultElevation = 4.dp),
        border = BorderStroke(1.5.dp, Color(0xFFE2E8F0))
    ) {
        Row(
            modifier = Modifier.fillMaxSize(),
            horizontalArrangement = Arrangement.SpaceBetween,
            verticalAlignment = Alignment.Bottom
        ) {
            Column(
                modifier = Modifier
                    .weight(1.2f)
                    .fillMaxHeight()
                    .padding(18.dp),
                verticalArrangement = Arrangement.SpaceBetween
            ) {
                Column {
                    Text(
                        text = "Reading Pieces",
                        color = Color(0xFF0284C7),
                        fontSize = 11.sp,
                        fontWeight = FontWeight.Bold,
                        letterSpacing = 1.sp
                    )
                    Spacer(modifier = Modifier.height(2.dp))
                    Text(
                        text = "Reading",
                        color = Color(0xFF0F172A),
                        fontSize = 20.sp,
                        fontWeight = FontWeight.ExtraBold
                    )
                    Spacer(modifier = Modifier.height(4.dp))
                    Text(
                        text = "Choose your level and practice with short reading passages.",
                        color = Color(0xFF64748B),
                        fontSize = 10.sp,
                        lineHeight = 13.sp
                    )
                }

                Button(
                    onClick = { navController.navigate("ReadingLevelSelection") },
                    colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF1CB0F6)),
                    shape = RoundedCornerShape(16.dp),
                    contentPadding = PaddingValues(horizontal = 16.dp, vertical = 0.dp),
                    modifier = Modifier.height(32.dp)
                ) {
                    Text(
                        text = "Start Reading",
                        color = Color.White,
                        fontSize = 11.sp,
                        fontWeight = FontWeight.Bold
                    )
                }
            }

            Image(
                painter = painterResource(id = R.drawable.readingcat),
                contentDescription = null,
                contentScale = ContentScale.Fit,
                modifier = Modifier
                    .weight(0.8f)
                    .fillMaxHeight(0.90f)
                    .padding(end = 12.dp, bottom = 8.dp)
            )
        }
    }
}

@Composable
fun MasteryCard() {
    val appColors = LocalAppThemeColors.current
    Card(
        modifier = Modifier
            .padding(vertical = 24.dp)
            .width(200.dp),
        shape = RoundedCornerShape(24.dp),
        colors = CardDefaults.cardColors(containerColor = appColors.surface),
        border = BorderStroke(2.dp, appColors.border)
    ) {
        Column(
            modifier = Modifier.padding(16.dp),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            Icon(
                imageVector = Icons.Default.Star, // Kupa ikonu yerine star
                contentDescription = null,
                modifier = Modifier.size(32.dp),
                tint = Color(0xFFB0BEC5)
            )
            Text("10. Mastery", fontWeight = FontWeight.Bold, color = appColors.text)
            Text("Finish all to unlock!", fontSize = 10.sp, color = appColors.textMuted)
        }
    }
}
@Composable
fun ResourceTag(icon: ImageVector, value: String) {
    Surface(
        shape = RoundedCornerShape(16.dp),
        color = Color(0xFFF1F5F9),
        modifier = Modifier.height(32.dp)
    ) {
        Row(
            modifier = Modifier.padding(horizontal = 8.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Icon(imageVector = icon, contentDescription = null, modifier = Modifier.size(18.dp), tint = Color(0xFFFFA000))
            Spacer(modifier = Modifier.width(4.dp))
            Text(text = value, fontWeight = FontWeight.Bold, fontSize = 13.sp)
            Icon(imageVector = Icons.Default.Add, contentDescription = null, modifier = Modifier.size(14.dp), tint = Color.Gray)
        }
    }
}
@Composable
fun QuizTreeBanner(screenWidth: Dp) {
    val context = LocalContext.current
    val appColors = LocalAppThemeColors.current
    val isSpaceTheme = remember(UserCosmeticsStore.stateRevision) {
        UserCosmeticsStore.isSpaceThemeActive(context)
    }
    val professorCatRes = if (isSpaceTheme) R.drawable.bigboxspace3 else R.drawable.professor_cat
    val bannerBorder = if (isSpaceTheme) {
        BorderStroke(1.5.dp, Brush.horizontalGradient(listOf(Color(0xFF818CF8), Color(0xFF38BDF8))))
    } else BorderStroke(1.dp, appColors.border)

    var startAnim by remember { mutableStateOf(false) }
    LaunchedEffect(Unit) {
        startAnim = true
    }

    // Ekranın en sağından soluna doğru ilerlesin
    val animatedOffset by animateDpAsState(
        targetValue = if (startAnim) 0.dp else screenWidth,
        animationSpec = tween(durationMillis = 1500, easing = FastOutSlowInEasing),
        label = "cat_slide"
    )

    Card(
        modifier = Modifier
            .fillMaxWidth()
            .padding(16.dp)
            .height(160.dp),
        shape = RoundedCornerShape(24.dp),
        colors = CardDefaults.cardColors(containerColor = if (isSpaceTheme) Color(0xFF0C132C) else appColors.background),
        border = bannerBorder,
        elevation = CardDefaults.cardElevation(2.dp)
    ) {
        Box(modifier = Modifier.fillMaxSize().background(if (isSpaceTheme) Color(0xFF0C132C) else appColors.background)) {
            // 🐱 Profesör Kedi (Sağdan Sola Hareketi, Sığdırma ve Sona Doğru Solma)
            Image(
                painter = painterResource(id = professorCatRes),
                contentDescription = null,
                contentScale = ContentScale.Crop, // Resmi kutucuğa dikeyde tam sığdır (boşluk kalmasın)
                modifier = Modifier
                    .align(Alignment.CenterEnd)
                    .fillMaxHeight()
                    .fillMaxWidth(0.70f) // Ekranın %70'inde dursun
                    .offset(x = animatedOffset)
                    .graphicsLayer(alpha = 0.99f) // DstIn blend mode offscreen buffer için gerekli
                    .drawWithContent {
                        val colors = listOf(Color.Black, Color.Transparent)
                        drawContent()
                        drawRect(
                            brush = Brush.horizontalGradient(
                                colors = colors,
                                startX = size.width * 0.55f, // Sağ tarafta daha uzun süre net kalsın (solma geç başlasın)
                                endX = 0f // Sol sınırda tamamen bitsin
                            ),
                            blendMode = BlendMode.DstIn
                        )
                    }
            )

            // ✍️ Metin Alanı (%45 Genişlik ve Kelime Bölmeme)
            Column(
                modifier = Modifier
                    .fillMaxHeight()
                    .fillMaxWidth(0.45f) // En fazla %45
                    .padding(20.dp),
                verticalArrangement = Arrangement.Center
            ) {
                Text(
                    text = if (isSpaceTheme) "Kozmik Quiz!" else "Quiz Zamanı!",
                    style = TextStyle(fontSize = 20.sp, fontWeight = FontWeight.Black, color = appColors.text),
                    softWrap = true // Kelime bölünmez
                )
                Spacer(modifier = Modifier.height(6.dp))
                Text(
                    text = if (isSpaceTheme) "Galaktik görevleri tamamla, kozmik kelime ağacını büyüt!" else "Hemen quizleri çöz, kelimeleri pekiştirerek İngilizce ağacını büyüt!",
                    style = TextStyle(fontSize = 12.sp, color = appColors.textMuted, fontWeight = FontWeight.Medium),
                    softWrap = true // Kelime bütünlüğü korunur
                )
            }
        }
    }
}
@Composable
fun FloatingBalloonButton(
    onClick: () -> Unit,
    modifier: Modifier = Modifier
) {
    val infiniteTransition = rememberInfiniteTransition(label = "balloon")
    val floatAnim by infiniteTransition.animateFloat(
        initialValue = -6f,
        targetValue = 6f,
        animationSpec = infiniteRepeatable(
            animation = tween(2000, easing = FastOutSlowInEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "balloon_float"
    )

    Box(
        modifier = modifier
            .offset(y = floatAnim.dp)
            .size(56.dp)
            .shadow(elevation = 6.dp, shape = CircleShape)
            .background(Color.White, CircleShape)
            .clickable { onClick() }
            .padding(8.dp),
        contentAlignment = Alignment.Center
    ) {
        Canvas(modifier = Modifier.fillMaxSize()) {
            val w = size.width
            val h = size.height
            val balloonRadius = w * 0.35f
            val balloonCenterX = w / 2f
            val balloonCenterY = h / 2f - 4f

            // String (İp)
            val path = Path().apply {
                moveTo(balloonCenterX, balloonCenterY + balloonRadius)
                quadraticTo(
                    balloonCenterX - 4f, balloonCenterY + balloonRadius + w * 0.2f,
                    balloonCenterX + 2f, balloonCenterY + balloonRadius + w * 0.4f
                )
            }
            drawPath(
                path = path,
                color = Color.LightGray,
                style = androidx.compose.ui.graphics.drawscope.Stroke(width = 2f, cap = StrokeCap.Round)
            )

            // Tie (Düğüm)
            val tiePath = Path().apply {
                moveTo(balloonCenterX, balloonCenterY + balloonRadius)
                lineTo(balloonCenterX - 4f, balloonCenterY + balloonRadius + 4f)
                lineTo(balloonCenterX + 4f, balloonCenterY + balloonRadius + 4f)
                close()
            }
            drawPath(tiePath, color = Color(0xFFF1F5F9))

            // Balloon Body (Beyaz 3D Görünüm)
            drawCircle(
                brush = Brush.radialGradient(
                    colors = listOf(Color.White, Color(0xFFE2E8F0)),
                    center = Offset(balloonCenterX - 3f, balloonCenterY - 3f),
                    radius = balloonRadius
                ),
                radius = balloonRadius,
                center = Offset(balloonCenterX, balloonCenterY)
            )

            // Shine (Parlama)
            drawCircle(
                color = Color.White.copy(alpha = 0.8f),
                radius = balloonRadius * 0.25f,
                center = Offset(balloonCenterX - balloonRadius * 0.3f, balloonCenterY - balloonRadius * 0.3f)
            )
        }
    }
}
@Composable
fun PipeConnection(width: Dp, height: Dp, pawCount: Int, isSolved: Boolean, isHorizontal: Boolean = false) {
    val color = if (isSolved) Color(0xFFD7F0D8) else Color(0xFFF2F2F2)
    val pawRes = if (isSolved) R.drawable.green_paw else R.drawable.black_paw

    Box(
        modifier = Modifier
            .size(width, height)
            .background(color), // Köşe yumuşatmayı kaldırdık ki kutulara tam otursun
        contentAlignment = Alignment.Center
    ) {
        if (isHorizontal) {
            Row(verticalAlignment = Alignment.CenterVertically) {
                repeat(pawCount) { idx ->
                    Image(painter = painterResource(id = pawRes), contentDescription = null, modifier = Modifier.size(14.dp).padding(horizontal = 2.dp))
                }
            }
        } else {
            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                repeat(pawCount) { idx ->
                    Image(painter = painterResource(id = pawRes), contentDescription = null, modifier = Modifier.size(14.dp).padding(vertical = 2.dp))
                }
            }
        }
    }
}

@Composable
fun QuizNodeWrapper(
    step: QuizStep,
    index: Int,
    sectionIndex: Int, // Bu parametreyi eklemelisin
    lastSolvedIndex: Int,
    navController: NavController,
    unitColors: List<Color>, // Renk listesini dışarıdan almalı
    modifier: Modifier = Modifier
) {
    // 1. Soru çözüldü mü?
    val isSolved = index <= lastSolvedIndex

    // 2. Soru kilitli mi?
    val isLocked = if (index == 0) false else index > lastSolvedIndex + 1

    // 🎨 Renk ve Hizalama Hesabı (15'li döngüye göre)
    val colorIdx = (index / 15) % unitColors.size
    val currentColor = unitColors[colorIdx]

    // Yılanlama hizalaması (Sinüs)
    val posInCycle = index % 15
    val angle = (posInCycle.toFloat() / 15f) * 2f * Math.PI.toFloat()
    val horizontalBias = kotlin.math.sin(angle).toFloat() * 0.75f
    val alignment = BiasAlignment(horizontalBias, 0f)

    Box(
        modifier = modifier.fillMaxWidth(),
        contentAlignment = alignment
    ) {
        DuoQuizNode(
            step = step, // 'item.step' yerine sadece 'step'
            isSolved = isSolved,
            isLocked = isLocked,
            starCount = 0,
            sectionIndex = sectionIndex,
            nodeColor = currentColor,
            totalQuestions = 10,
            currentIndex = index,
            onClick = {
                if (!isLocked) {
                    val routeNumber = index + 1 // 'item.quizIndex' yerine 'index'
                    navController.navigate("test_$routeNumber")
                }
            }
        )
    }
}

// --- 💡 YARDIMCI COMPOSABLE: DuoQuizNode (Senin PNG'lerini çeken versiyon) ---
@Composable
fun DuoQuizNode(
    step: QuizStep,
    modifier: Modifier = Modifier,
    isSolved: Boolean,
    isLocked: Boolean,
    starCount: Int,
    blueStarCount: Int = 0,
    sectionIndex: Int,
    nodeColor: Color,
    currentIndex: Int,
    totalQuestions: Int,
    onClick: () -> Unit
) {
    val appColors = LocalAppThemeColors.current
    val isDark = LocalIsDarkMode.current
    val actionBlue = Color(0xFF42A5F5)
    val lockedBackground = if (isDark) appColors.surfaceRaised else Color(0xFFF1F5F9)

    // Yamalanan: İlk adım her zaman açık olsun mantığı
    val finalLockedState = remember(step.id, isLocked) {
        if (step.id == 1) false else isLocked
    }

    // Yamalanan: Görseldeki gibi zigzag akışı için dinamik genişlik
    val dynamicWidth = when {
        currentIndex == 0 -> 280.dp // İlk ünite geniş başlasın
        else -> 180.dp              // Diğerleri ikili sıra için dar olsun
    }

    Card(
        modifier = modifier
            .padding(vertical = 10.dp, horizontal = 12.dp)
            .width(dynamicWidth)
            .height(72.dp)
            .clickable { onClick() },
        shape = RoundedCornerShape(24.dp),
        colors = CardDefaults.cardColors(
            containerColor = if (finalLockedState) lockedBackground else appColors.surface
        ),
        border = BorderStroke(1.dp, appColors.border),
        elevation = CardDefaults.cardElevation(defaultElevation = 3.dp)
    ) {
        Row(
            modifier = Modifier.fillMaxSize().padding(horizontal = 16.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            // İkon Bölümü (Tik/Kilit)
            Box(
                modifier = Modifier
                    .size(36.dp)
                    .clip(CircleShape)
                    .background(if (isSolved) actionBlue.copy(alpha = 0.1f) else Color.Transparent)
                    .border(1.5.dp, if (finalLockedState) (if (isDark) appColors.border else Color(0xFFCBD5E1)) else actionBlue, CircleShape),
                contentAlignment = Alignment.Center
            ) {
                if (finalLockedState) {
                    Image(
                        painter = painterResource(id = R.drawable.padlock),
                        contentDescription = "Locked",
                        modifier = Modifier.size(24.dp)
                    )
                } else {
                    Icon(imageVector = Icons.Default.Check, contentDescription = null, tint = actionBlue, modifier = Modifier.size(20.dp))
                }
            }

            Spacer(modifier = Modifier.width(12.dp))

            Column(modifier = Modifier.weight(1f)) {
                Text(
                    text = "${step.id}. ${step.title}",
                    style = TextStyle(fontSize = 14.sp, fontWeight = FontWeight.Bold, color = if (finalLockedState) appColors.textMuted else appColors.text),
                    maxLines = 1,
                    overflow = TextOverflow.Ellipsis
                )

                if (!finalLockedState) {
                    Row(modifier = Modifier.padding(top = 2.dp)) {
                        repeat(3) { index ->
                            val starColor = when {
                                index < blueStarCount -> Color(0xFF42A5F5) // Blue Star
                                index < starCount -> Color(0xFFFFB300) // Yellow Star
                                else -> if (isDark) Color(0xFF334155) else Color(0xFFE2E8F0) // Gray Star
                            }
                            Icon(
                                imageVector = Icons.Default.Star,
                                contentDescription = null,
                                modifier = Modifier.size(14.dp),
                                tint = starColor
                            )
                        }
                    }
                }
            }
        }
    }
}
data class QuizStep(
    val id: Int,
    val title: String = "",
    val imageRes: Any,
    val qmoji: String = "",
    val instruction: String = "",
    val correctSentence: List<String> = emptyList(),
    val type: String = "ordering",
    val wordMap: Map<String, String> = emptyMap()
)

class QuizList(
    val wordsLearned: Int,
    val questions: List<VocabularyLevelDataQuiz>
) : List<VocabularyLevelDataQuiz> by questions

fun quizListOf(wordsLearned: Int, vararg elements: VocabularyLevelDataQuiz): QuizList {
    return QuizList(wordsLearned, elements.toList())
}

