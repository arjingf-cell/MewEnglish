fun getQuiz275(): List<VocabularyLevelDataQuiz> {
    return quizListOf(
        7, // 👈 Gramer / Modal olumsuz başlangıç seti

        // 1. LISTENING (Giriş Sezdirme Sorusu - Karakter Avatarlı)
        createListening(
            id = 1,
            qTurkish = "You shouldn't sleep late on school nights.",
            res = R.drawable.pp1,
            ansEnglish = "Okul gecelerinde geç uyumamalısın.",
            opts = listOf(
                "Okul gecelerinde geç uyumamalısın.",
                "Okul günlerinde erken uyanmalısın.",
                "Sınavdan önce çok çalışmalısın.",
                "Derste sessizce oturmalısın."
            )
        ),

        // 2. INFO_CARD ("Shouldn't / Should not" Modalının Mantığı ve Yapısı)
        VocabularyLevelDataQuiz(
            id = 2,
            questionType = QuestionType.INFO_CARD,
            speakingTitle = "Modals: SHOULDN'T / SHOULD NOT (Olumsuz Tavsiye)",
            fullAnswerTurkish = "İngilizcede birinin yapmaması gereken, yanlış veya zararlı olan şeyleri söylemek için 'shouldn't' (should not) kullanırız.\n\n• Tüm öznelerde (I, you, he, she, we, they) 'shouldn't' değişmeden aynı kalır.\n• 'shouldn't' sonrasında gelen fiil her zaman yalın (ek almamış) halde kullanılır.\n\nÖrnekler:\n• You shouldn't eat fast food every day. (Her gün fast food y namamalısın.)\n• He shouldn't drive fast in the rain. (Yağmurda hızlı sürmemeli.)\n• We shouldn't waste water. (Suyu boşa harcamamalıyız.)",
            imageRes = R.drawable.pp2
        ),

        // 3. PATTERN (Giriş Pekiştirme: shouldn't + yalın fiil kuralı)
        VocabularyLevelDataQuiz(
            id = 3,
            questionType = QuestionType.PATTERN,
            patternTitle = "Negative Advice with SHOULDN'T (Olumsuz Tavsiye Kuralı)",
