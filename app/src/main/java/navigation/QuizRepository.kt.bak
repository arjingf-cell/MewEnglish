// QUIZ 301: Quantifiers Bölüm 1 (How Much vs How Many Temelleri)
// ========================================================
fun getQuiz301(): List<VocabularyLevelDataQuiz> {
    return quizListOf(
        4, // 👈 2 yeni kavram: How much & How many

        // 1. Soru: createListening (Doğrudan "How much?" açılışı)
        createListening(
            id = 1,
            qTurkish = "How much?",
            res = R.drawable.pp1,
            ansEnglish = "Ne kadar?",
            opts = listOf("Ne kadar?", "Kaç tane?", "Ne zaman?", "Nerede?")
        ),

        // 2. Soru: createInfoCard (Temel Fark: How much vs How many)
        createInfoCard(
            id = 2,
            title = "HOW MUCH vs HOW MANY",
            text = "İngilizcede miktar sorarken iki temel soru kalıbı kullanırız:\n\n1. How Many? = Kaç tane?\nSayılabilen ve sonuna -s çoğul eki alabilen isimlerle kullanılır (books, apples, cars, friends).\n\n2. How Much? = Ne kadar?\nTek tek sayılamayan isimlerle kullanılır (water, money, milk, time).",
            highlights = listOf("How Many", "Kaç tane", "How Much", "Ne kadar")
        ),

        // 3. Soru: QuestionType.PATTERN (Su / How much seçimi)
        VocabularyLevelDataQuiz(
            id = 3,
            questionType = QuestionType.PATTERN,
            patternTitle = "How Much / How Many Seçimi",
            patternExampleOne = "How much water do you drink?",
            patternHighlightOne = "How much",
            patternExampleTwo = "How many books do you read?",
            patternHighlightTwo = "How many",
            questionTurkish = "_______ water do you need for the recipe?",
            imageRes = R.drawable.water,
            correctAnswer = "How much",
            options = listOf("How much", "How many", "How long", "How old")
        ),

        // 4. Soru: createInfoCard (Altın Test Kuralı: "1 süt, 2 süt" testi)
        createInfoCard(
            id = 4,
            title = "ALTIN TEST: SAYI TESTİ",
            text = "Bir kelimenin sayılabilen mi yoksa sayılamayan mı olduğunu anlamak için başına sayı koymayı dene:\n\n❌ Mantıksız ise SAYILAMAYANDIR (How much kullanılır):\n'1 süt, 2 süt' veya '1 su, 2 su' denmez! ➔ How much milk!\n\n✅ Mantıklı ve oluyorsa SAYILABİLENDİR (How many kullanılır):\n'1 yumurta, 2 yumurta' denir! ➔ How many eggs!",
            highlights = listOf("How much milk", "How many eggs", "SAYILAMAYANDIR", "SAYILABİLENDİR")
        ),

        // 5. Soru: createInfoCard (Para Mantığı: Money neden sayılamaz?)
        createInfoCard(
            id = 5,
            title = "DİKKAT: PARA (MONEY) NEDEN SAYILAMAZ?",
            text = "Günlük hayatta 'paramı sayıyorum' desek de İngilizcede 'money' (para) kelimesi SAYILAMAYAN (uncountable) kabul edilir!\n\nÇünkü biz parayı değil, aradaki banknotları ve para birimlerini (lira, dollar, euro) sayarız.\n\nBu yüzden her zaman:\n➔ 'How much money do you have?' (Ne kadar paran var?) denir!",
            highlights = listOf("money", "SAYILAMAYAN", "How much money")
        ),

        // 6. Soru: QuestionType.PATTERN (Arkadaş / How many seçimi)
        VocabularyLevelDataQuiz(
            id = 6,
            questionType = QuestionType.PATTERN,
            patternTitle = "Sayılabilen İsimlerle Soru (How Many)",
            patternExampleOne = "How many friends do you have?",
            patternHighlightOne = "How many friends",
            patternExampleTwo = "How much time do we have?",
            patternHighlightTwo = "How much time",
            questionTurkish = "_______ friends are coming to your party tonight?",
            imageRes = R.drawable.kisi1,
            correctAnswer = "How many",
            options = listOf("How many", "How much", "How often", "How far")
